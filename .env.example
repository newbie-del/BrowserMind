NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEON_BRANCH=main
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Trigger.dev — get from the dashboard API Keys page (DEV key starts with tr_dev_)
TRIGGER_SECRET_KEY=

NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

# Optional legacy remote engine; local Browser-Use execution does not use it.
BROWSERBASE_API_KEY=

# Browser-Use agent engine
# The local runner uses Gemini by default; set provider=browser-use only
# when the Browser Use LLM Gateway account is enabled.
GOOGLE_API_KEY=
BROWSER_USE_LLM_PROVIDER=google
BROWSER_USE_GOOGLE_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
BROWSER_USE_OPENAI_MODEL=gpt-4o-mini
BROWSER_USE_API_KEY=
BROWSER_USE_KEEP_BROWSER_OPEN=true
BROWSER_USE_MAX_STEPS=80
BROWSER_USE_MAX_FAILURES=1
ANONYMIZED_TELEMETRY=false
# Resend test mode only permits the account owner until a sending domain is verified.
WORKFLOW_RESULTS_EMAIL=justin10khan@gmail.com
# Optional when the Browser-Use checkout is not at ..\browser-use
BROWSER_USE_SOURCE_PATH=
# Optional path to the Browser-Use virtualenv Python executable
BROWSER_USE_PYTHON=

RESEND_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time secret for source map upload (starts with sntrys_)
SENTRY_AUTH_TOKEN=
